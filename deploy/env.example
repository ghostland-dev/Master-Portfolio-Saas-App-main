# Configuration de l'environnement de production
# Copiez ce fichier vers .env et configurez les valeurs

# ===========================================
# CONFIGURATION DE L'APPLICATION
# ===========================================
NODE_ENV=production
DOMAIN=portfolio.example.com
DOCKER_IMAGE=your-dockerhub-username/portfolio-saas:latest

# ===========================================
# CONFIGURATION DE LA BASE DE DONNÉES
# ===========================================
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================================
# CONFIGURATION SUPABASE
# ===========================================
# Clé anonyme Supabase (publique)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Clé de service Supabase (privée)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ===========================================
# CONFIGURATION JWT
# ===========================================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=3600

# ===========================================
# CONFIGURATION PGRST
# ===========================================
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ===========================================
# CONFIGURATION STUDIO
# ===========================================
STUDIO_DEFAULT_ORGANIZATION_NAME=Default Organization
STUDIO_DEFAULT_PROJECT_NAME=Default Project

# ===========================================
# CONFIGURATION SMTP (OPTIONNEL)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SENDER_NAME=Portfolio SaaS
SMTP_ADMIN_EMAIL=admin@example.com

# ===========================================
# CONFIGURATION AUTHENTIFICATION
# ===========================================
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
DISABLE_SIGNUP=false

# ===========================================
# CONFIGURATION REDIRECTS
# ===========================================
ADDITIONAL_REDIRECT_URLS=https://portfolio.example.com/**,http://localhost:3000/**
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ===========================================
# CONFIGURATION IMGPROXY
# ===========================================
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ===========================================
# CONFIGURATION ANALYTICS
# ===========================================
LOGFLARE_API_KEY=your_logflare_api_key_here

# ===========================================
# CONFIGURATION DOCKER HUB (OPTIONNEL)
# ===========================================
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

