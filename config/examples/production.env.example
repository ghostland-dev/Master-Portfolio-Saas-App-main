# Configuration de production pour Portfolio SaaS
# Copier ce fichier vers .env.production et ajuster les valeurs

# ===========================================
# CONFIGURATION DE L'APPLICATION
# ===========================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# CONFIGURATION SUPABASE
# ===========================================
# URL publique de l'API Supabase (navigateur + fallback serveur)
NEXT_PUBLIC_SUPABASE_URL=https://your-domain.com
# Optionnel : URL interne si l’app Node ne peut pas joindre l’URL publique (Docker / VPC)
# SUPABASE_SERVER_URL=http://kong:8000
SUPABASE_URL=https://your-domain.com

# Clés d'API Supabase (à générer via le dashboard Supabase)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here
SERVICE_ROLE_KEY=your_production_service_role_key_here

# ===========================================
# CONFIGURATION BASE DE DONNÉES
# ===========================================
POSTGRES_DB=portfolio_prod
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de connexion complète
DATABASE_URL=postgresql://portfolio_user:your_secure_database_password_here@db:5432/portfolio_prod

# ===========================================
# CONFIGURATION JWT
# ===========================================
JWT_SECRET=your_super_secret_jwt_token_with_at_least_32_characters_long
JWT_EXPIRY=3600
JWT_AUD=authenticated

# ===========================================
# CONFIGURATION EMAIL (SMTP DE PRODUCTION)
# ===========================================
# Configuration SMTP pour les emails de production
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password
SMTP_SENDER_NAME=Portfolio SaaS

# Configuration GoTrue pour l'authentification
GOTRUE_SMTP_HOST=smtp.your-provider.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=your-email@domain.com
GOTRUE_SMTP_PASS=your-email-password
GOTRUE_SMTP_SENDER_NAME=Portfolio SaaS

# URLs de redirection pour l'authentification
GOTRUE_SITE_URL=https://your-domain.com
GOTRUE_URI_ALLOW_LIST=https://your-domain.com,https://www.your-domain.com

# ===========================================
# CONFIGURATION SÉCURITÉ
# ===========================================
# CORS - Domaines autorisés
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Headers de sécurité
SECURITY_HEADERS=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block

# ===========================================
# CONFIGURATION MONITORING
# ===========================================
# Logs
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# ===========================================
# CONFIGURATION CACHE
# ===========================================
# Redis (optionnel)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_redis_password_here

# Cache TTL (en secondes)
CACHE_TTL=3600

# ===========================================
# CONFIGURATION CDN
# ===========================================
# CDN pour les assets statiques
CDN_URL=https://cdn.your-domain.com
ASSETS_URL=https://assets.your-domain.com

# ===========================================
# CONFIGURATION ANALYTICS
# ===========================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry pour le monitoring d'erreurs
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===========================================
# CONFIGURATION BACKUP
# ===========================================
# Configuration des sauvegardes
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1

# ===========================================
# CONFIGURATION ALERTES
# ===========================================
# Email pour les alertes
ALERT_EMAIL=admin@domain.com
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Seuils d'alerte
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=90

# ===========================================
# CONFIGURATION DÉPLOIEMENT
# ===========================================
# Environnement de déploiement
DEPLOY_ENVIRONMENT=production
DEPLOY_VERSION=1.0.0

# Configuration Docker
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest

# ===========================================
# CONFIGURATION SSL/TLS
# ===========================================
# Certificats SSL
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# Configuration HTTPS
HTTPS_REDIRECT=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# ===========================================
# CONFIGURATION RATE LIMITING
# ===========================================
# Limitation du taux de requêtes
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CONFIGURATION SESSION
# ===========================================
# Configuration des sessions
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
